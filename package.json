{
  "name": "calendar-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Faster and lighter multi-platform calendar application",
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:api": "cargo run --manifest-path api/Cargo.toml",
    "dev:app": "cd app && flutter run",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "build:web": "npm --prefix web run build",
    "build:api": "cargo build --release --manifest-path api/Cargo.toml",
    "lint:web": "npm --prefix web run lint",
    "lint:api": "cargo clippy --manifest-path api/Cargo.toml -- -D warnings",
    "lint": "npm run lint:web",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\" && cargo fmt --manifest-path api/Cargo.toml",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\" && cargo fmt --manifest-path api/Cargo.toml -- --check",
    "commit": "cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "commitizen": "^4.3.1",
    "cz-git": "^1.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
