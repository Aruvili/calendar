# Environment Configuration Template
# Copy this file to .env: cp .env.example .env

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=calendar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calendar

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Backend API (Actix Web)
API_HOST=127.0.0.1
API_PORT=8080
RUST_LOG=info,actix_web=info,api=debug

# Web Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080
PORT=3000

# App Client (Flutter)
APP_API_BASE_URL=http://localhost:8080
