#!/usr/bin/env sh
# Prevent accidental direct pushes to main branch in production repo
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
  if [ -z "$ALLOW_DIRECT_MAIN_PUSH" ]; then
    echo "================================================================="
    echo "ERROR: Direct push to '$current_branch' is prohibited by policy!"
    echo "Please create a feature branch and submit a Pull Request:"
    echo "  git checkout -b feat/your-feature-name"
    echo "  git push origin feat/your-feature-name"
    echo ""
    echo "(Emergency override: ALLOW_DIRECT_MAIN_PUSH=1 git push ...)"
    echo "================================================================="
    exit 1
  fi
fi
